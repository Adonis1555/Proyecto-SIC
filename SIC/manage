#!/usr/bin/env bash
# Activa el venv relativo a esta carpeta y pasa todos los argumentos a manage.py
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/venv/bin/activate" 2>/dev/null || source "$SCRIPT_DIR/.venv/bin/activate"
exec python "$SCRIPT_DIR/manage.py" "$@"
													
  
